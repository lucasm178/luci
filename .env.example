# URL pública do servidor Ollama, sem /api/generate no final.
# Na Vercel, localhost não funciona: use seu túnel HTTPS (Cloudflare/ngrok).
OLLAMA_API_URL=https://seu-tunel.exemplo.com

# Modelo criado pelo Modelfile antigo: ollama create berno -f Modelfile
OLLAMA_MODEL=berno

# Opcional, somente se o proxy/túnel exigir autenticação Bearer.
OLLAMA_API_KEY=
